# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (DOCKER)
# ==========================================
# Estos valores coinciden con la configuración por defecto del docker-compose.yml
DB_HOST=db
DB_USER=root
DB_PASSWORD=secret
DB_NAME=app_db

# ==========================================
# GOOGLE GMAIL API (OAUTH 2.0)
# ==========================================
# Sustituye estos valores por las credenciales de tu proyecto en Google Cloud Console
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
# URL de redirección autorizada en Google Cloud (por defecto entorno local)
GOOGLE_REDIRECT_URI=http://localhost:8080/settings/callback

# ==========================================
# GOOGLE GEMINI API (IA)
# ==========================================
# Genera tu API Key gratuita en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_de_gemini_aqui